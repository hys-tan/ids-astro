---
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import Navbar from '../components/layout/navbar';
import Footer from '../components/layout/footer.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	description?: string;
}

const { 
	title, 
	description = "Empresa especializada en servicios técnicos integrales: mantenimiento preventivo y correctivo." 
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />


		<!-- Icono clásico de respaldo (el ICO que generaste) -->
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />

		<!-- Icono moderno en alta calidad (tu logo SVG) -->
		<link rel="icon" type="image/svg+xml" href="/idelsi.svg" />

		<!-- Icono para celulares Apple (el PNG que te generó favicon.io) -->
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

		<!-- Iconos para Android/Chrome y el Manifiesto que configuramos -->
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="manifest" href="/site.webmanifest" />


		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Básico -->
		<ClientRouter />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body transition:animate="none">
		<Navbar client:load transition:persist />
		
		<main transition:animate="none">
			<slot /> <!-- Aquí va el contenido de cada página -->
		</main>
		
		<Footer transition:persist />
	
		<!-- Script global de Lenis para Smooth Scroll -->
		<script>
			import Lenis from 'lenis';
			
            const initLenis = () => {
                if (typeof window !== 'undefined') {
                    // @ts-ignore
                    window.lenis = new Lenis({
                        autoRaf: true,
                        lerp: 0.05,             // 0.08
                        wheelMultiplier: 1.5    // 1.2
                    });

                    // Interceptar enlaces con hash para Smooth Scroll sin modificar la URL
                    document.body.addEventListener('click', (e) => {
                        // @ts-ignore
                        const target = (e.target as HTMLElement).closest('a[href^="#"]');
                        if (target) {
                            const href = target.getAttribute('href');
                            if (href === '#') return;
                            
                            const targetElement = document.querySelector(href || '');
                            // @ts-ignore
                            if (targetElement && window.lenis) {
                                e.preventDefault(); // Evitar salto instantáneo y adición del hash a la URL
                                // @ts-ignore
                                window.lenis.scrollTo(targetElement, {
                                    offset: 0,
                                    duration: 1.2
                                });
                            }
                        }
                    });
                }
            };

            // Ejecutar al cargar la página o al navegar
            document.addEventListener('astro:page-load', initLenis);

            // Swap Inteligente: Reemplazar únicamente el <main> para que la Navbar NUNCA sea desmontada ni parpadee
            document.addEventListener('astro:before-swap', (e: any) => {
                // Limpiar la instancia de Lenis al cambiar de página
                // @ts-ignore
                if (window.lenis) {
                    // @ts-ignore
                    window.lenis.destroy();
                    // @ts-ignore
                    window.lenis = null;
                }

                // Personalizar el swap de Astro para aislar el cambio solo a <main>
                e.swap = () => {
                    // 1. Sincronizar título y metadatos SEO del <head>
                    document.title = e.newDocument.title;
                    const oldDesc = document.querySelector('meta[name="description"]');
                    const newDesc = e.newDocument.querySelector('meta[name="description"]');
                    if (oldDesc && newDesc) {
                        oldDesc.setAttribute('content', newDesc.getAttribute('content') || '');
                    }

                    // 2. Sincronizar nuevos estilos del <head> si la página entrante tiene hojas de estilo adicionales
                    e.newDocument.head.querySelectorAll('style, link[rel="stylesheet"]').forEach((el: Element) => {
                        const exists = Array.from(document.head.children).some((child) => child.isEqualNode(el));
                        if (!exists) {
                            document.head.appendChild(el.cloneNode(true));
                        }
                    });

                    // 3. Reemplazar ÚNICAMENTE el contenedor central <main>
                    const oldMain = document.querySelector('main');
                    const newMain = e.newDocument.querySelector('main');
                    if (oldMain && newMain) {
                        oldMain.replaceWith(newMain);
                    }

                    // 4. Asegurar que la nueva página comience siempre arriba
                    window.scrollTo(0, 0);
                };
            });
		</script>
	</body>

</html>


<!-- MODIFICAR AL FINAL PARA EL SEO -->